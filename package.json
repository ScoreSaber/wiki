{
  "name": "@scoresaber/wiki",
  "version": "2.0.0",
  "private": true,
  "description": "ScoreSaber Wiki",
  "license": "MIT",
  "author": "Umbranox <umbra@scoresaber.com>",
  "type": "module",
  "scripts": {
    "lint:md": "markdownlint content/docs/",
    "lint:md:fix": "markdownlint --fix content/docs/",
    "dev": "vp run i18n:generate && next dev",
    "build": "vp run i18n:generate && fumadocs-mdx && _FUMADOCS_MDX=1 next build && vp run build:aliases",
    "start": "serve out",
    "typecheck": "vp run i18n:generate && fumadocs-mdx && _FUMADOCS_MDX=1 next typegen && tsc --noEmit",
    "postinstall": "vp run i18n:generate && fumadocs-mdx",
    "build:aliases": "node scripts/create-static-aliases.ts",
    "i18n:generate": "node scripts/generate-active-locales.ts",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "fumadocs-core": "^16.9.0",
    "fumadocs-mdx": "^15.0.7",
    "fumadocs-ui": "^16.9.0",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remark-directive": "^4.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "markdownlint-cli": "^0.48.0",
    "postcss": "^8.5.15",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11.20.0 <12"
  },
  "packageManager": "pnpm@11.20.0"
}
